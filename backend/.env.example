# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost

# Authinator Integration
AUTHINATOR_API_URL=http://localhost:8001/api/auth/
AUTHINATOR_VERIFY_SSL=False

# Service Registry (for microservice discovery)
SERVICE_REGISTRY_URL=http://localhost:8001/api/services/register/
SERVICE_REGISTRATION_KEY=dev-service-key-change-in-production

# WebAuthn Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RMAinator
WEBAUTHN_ORIGIN=http://localhost:3002

# Google OAuth2 (optional - for SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth2 (optional - for SSO)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Auth0 (optional - for SSO)
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_URL=https://your-domain.auth0.com

# Okta (optional - for SSO)
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_BASE_URL=https://your-domain.okta.com
